# Google OAuth client ID for the Calendar API (chrome.identity).
# This is a PUBLIC client identifier, not a secret — it ships in the built
# extension manifest. It's kept here only for config hygiene / per-environment
# swaps. It must be a "Chrome Extension" OAuth client whose Item ID is the
# pinned extension ID (nblafpggejpkjeelebiigcdghkceknea).
#
# Copy this file to .env and fill in the value:
#   cp apps/extension/.env.example apps/extension/.env
GOOGLE_OAUTH_CLIENT_ID=

# Base URL of the CallCost backend that exposes /api/event-cost.
# OPTIONAL — leave blank to use the default http://localhost:3000. Set it to
# point the built extension at a deployed backend instead of localhost. Vite
# bakes it in at build time (must be VITE_-prefixed to reach runtime code), and
# it also drives the backend entry in the manifest's host_permissions.
#   e.g. VITE_SERVER_URL=https://callcost.internal.example.com
VITE_SERVER_URL=
