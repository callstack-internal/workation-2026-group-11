# Must be the SAME value as apps/extension/.env's GOOGLE_OAUTH_CLIENT_ID.
# The server checks this against the `aud` claim on tokens it's asked to
# verify, so it only trusts tokens actually issued to the CallCost extension
# (not some other app that also happens to have `email` scope).
#
# This is a public client identifier, not a secret.
#
# Copy this file to .env and fill in the value:
#   cp apps/server/.env.example apps/server/.env
GOOGLE_OAUTH_CLIENT_ID=

# Optional: port the server listens on. Defaults to 3000.
# PORT=3000
